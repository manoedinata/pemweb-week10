meta {
  name: Create Product
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/products
  body: json
  auth: none
}

body:json {
  {
    "name": "Penghapus",
    "price": 3000
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  // Simpan id produk baru agar dipakai request PUT dan DELETE
  if (res.status === 201) {
    bru.setVar("productId", res.body.id);
  }
}
